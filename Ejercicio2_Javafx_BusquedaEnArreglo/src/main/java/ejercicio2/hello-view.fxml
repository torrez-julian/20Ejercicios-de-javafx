<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/21" fx:controller="com.tuempresa.ejercicio2_javafx_busquedaenarreglo.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <HBox alignment="CENTER" spacing="10.0">
        <TextField fx:id="txtNumero" promptText="Número a agregar" />
        <Button fx:id="btnAgregar" onAction="#onAgregarClick" text="Agregar" />
        <Button fx:id="btnReiniciar" onAction="#onReiniciarClick" text="Reiniciar" />
    </HBox>

    <HBox alignment="CENTER" spacing="10.0">
        <TextField fx:id="txtBuscar" promptText="Número a buscar" />
        <Button fx:id="btnBuscar" onAction="#onBuscarClick" text="Buscar" />
    </HBox>

    <Label fx:id="lblEstado" text="Ingresados: 0 de 10" />
    <Label fx:id="lblResultado" text="Ingrese los números para iniciar la búsqueda." textAlignment="CENTER" wrapText="true" />
</VBox>