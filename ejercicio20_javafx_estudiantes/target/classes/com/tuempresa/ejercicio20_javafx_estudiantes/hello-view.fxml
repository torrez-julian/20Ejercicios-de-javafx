<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="12.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.tuempresa.ejercicio20_javafx_estudiantes.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label text="Registro de Calificaciones" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

    <HBox spacing="10.0" alignment="CENTER">
        <TextField fx:id="txtNombre" promptText="Nombre del alumno" prefWidth="150.0"/>
        <TextField fx:id="txtNota" promptText="Nota (0-100)" prefWidth="100.0"/>
        <Button text="Registrar" onAction="#onRegistrarClick"/>
    </HBox>

    <TextArea fx:id="txtReporte" editable="false" prefHeight="130.0" style="-fx-font-family: monospace;"/>

    <Button text="Limpiar Lista" onAction="#onLimpiarClick"/>
</VBox>
