<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="12.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.tuempresa.ejercicio8_javafx_multiplicacion.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label text="Multiplicación de Matrices (2x2)" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

    <Label text="Matriz A (4 enteros separados por comas):"/>
    <TextField fx:id="txtMatrizA" promptText="ej: 1, 2, 3, 4"/>

    <Label text="Matriz B (4 enteros separados por comas):"/>
    <TextField fx:id="txtMatrizB" promptText="ej: 5, 6, 7, 8"/>

    <Button text="Multiplicar Matrices" onAction="#onMultiplicarClick"/>

    <TextArea fx:id="txtResultado" editable="false" prefHeight="130.0" style="-fx-font-family: monospace;"/>
</VBox>
